# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Configuration
# Option 1: Full connection string
DATABASE_URL=postgresql://telegram_bot_user:telegram_bot_secure_pass_2024@localhost:5432/telegram_finance_db

# Option 2: Individual variables (alternative to DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=telegram_finance_db
# DB_USER=telegram_bot_user
# DB_PASSWORD=telegram_bot_secure_pass_2024

# Logging Configuration
LOG_LEVEL=info

# Validation Thresholds
HIGH_AMOUNT_THRESHOLD=5000
DUPLICATE_TIME_WINDOW_MINUTES=30
